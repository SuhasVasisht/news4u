{
  "name": "news-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "python3 scripts/with-publisher-lock.py node --import tsx scripts/build-static.tsx",
    "build:daily": "python3 scripts/with-publisher-lock.py node --import tsx scripts/build-static.tsx --collect",
    "review:prepare": "python3 scripts/with-publisher-lock.py node --import tsx scripts/build-static.tsx --collect --prepare-review",
    "review:apply": "python3 scripts/with-publisher-lock.py node --import tsx scripts/build-static.tsx --review-file",
    "sports:prepare": "python3 scripts/with-publisher-lock.py node --import tsx scripts/build-static.tsx --prepare-sports",
    "sports:apply": "python3 scripts/with-publisher-lock.py node --import tsx scripts/build-static.tsx --sports-review-file",
    "deploy:static": "python3 scripts/with-publisher-lock.py node --import tsx scripts/deploy-cloudflare.ts",
    "verify:deployed": "tsx scripts/verify-static-site.ts",
    "publish:daily": "python3 scripts/with-publisher-lock.py node --import tsx scripts/publish-daily.ts",
    "publish:static": "npm test && npm run build:static && npm run deploy:static",
    "start": "next start",
    "lint": "eslint src tests scripts *.config.ts *.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:collector": "scripts/news_collector/.venv/bin/python -m pytest scripts/news_collector/tests",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:collector && npm run build && npm run test:e2e",
    "audit:data-pipeline": "tsx scripts/audit-data-pipeline.ts",
    "job:daily-sync": "tsx scripts/daily-sync.ts",
    "startup:catchup": "tsx scripts/startup-catchup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "publish:check": "python3 scripts/with-publisher-lock.py node --import tsx scripts/publish-daily.ts --check"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.2",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4",
    "wrangler": "4.130.0"
  }
}

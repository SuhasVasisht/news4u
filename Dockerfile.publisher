FROM ghcr.io/astral-sh/uv:0.10.9 AS uv
FROM node:22.22.0-bookworm-slim
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates tzdata git tar \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && npm install --global @openai/codex@0.157.1
COPY scripts/news_collector/ scripts/news_collector/
ENV UV_PYTHON_DOWNLOADS=never PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN uv sync --project scripts/news_collector --locked --extra dev --python /usr/bin/python3 \
    && npx playwright install --with-deps chromium \
    && scripts/news_collector/.venv/bin/python -m playwright install chromium
COPY . .
RUN groupadd --gid 10001 publisher && useradd --uid 10001 --gid publisher --create-home publisher \
    && mkdir -p data out scripts/news_collector/data scripts/news_collector/output scripts/news_collector/.pytest_cache node_modules/.vite node_modules/.cache /state/codex /backups \
    && chown publisher:publisher /app data out scripts/news_collector/data scripts/news_collector/output scripts/news_collector/.pytest_cache node_modules node_modules/.vite node_modules/.cache /state /state/codex /backups
ENV NODE_ENV=production PYTHONUNBUFFERED=1 TZ=America/Los_Angeles APP_TIMEZONE=America/Los_Angeles \
    CODEX_HOME=/state/codex NEWS_BACKUP_DIR=/backups PYTHONDONTWRITEBYTECODE=1
USER publisher
CMD ["npm", "run", "publish:daily"]

# Copy to /etc/news-publisher/publisher.env (mode 0600), never commit real values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEWS_MAIL_HOST=imap.gmail.com
NEWS_MAIL_ENABLED=1
NEWS_MAIL_PORT=993
NEWS_MAIL_USERNAME=
# Gmail app password, not the account password; remove spaces.
NEWS_MAIL_PASSWORD=
NEWS_MAIL_FOLDER=INBOX
NEWS_COLLECTOR_USER_AGENT=news-collector/0.1 (set your contact email)
# Optional source credentials; retain existing enabled-source configuration.
NEWSAPI_KEY=
GUARDIAN_API_KEY=
ALPHAVANTAGE_API_KEY=
PRODUCTHUNT_TOKEN=
# Optional explicit editor model. Blank uses the pinned Codex CLI default.
NEWS_EDITOR_MODEL=
NEWS_EDITOR_REASONING_EFFORT=
